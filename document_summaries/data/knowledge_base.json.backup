    },
    "/home/batesk52/CMU.49.007-Literature-Review/document_summaries/by_type/pdfs/josh_berke_what_does_dopamine_mean.md": {
      "file_path": "/home/batesk52/CMU.49.007-Literature-Review/document_summaries/by_type/pdfs/josh_berke_what_does_dopamine_mean.md",
      "relative_path": "/home/batesk52/CMU.49.007-Literature-Review/document_summaries/by_type/pdfs/josh_berke_what_does_dopamine_mean.md",
      "filename": "josh_berke_what_does_dopamine_mean.md",
      "summary": "This markdown document is a summary of a PDF by Josh Berke titled \"What does dopamine mean?\". The document discusses the role of dopamine as a critical modulator of learning and motivation, with a focus on how target cells interpret increased dopamine levels. It is particularly relevant for those interested in neuroscience and the study of neurotransmitters.",
