    "/home/batesk52/CMU.49.007-Literature-Review/document_summaries/by_type/pdfs/dheeraj_s_roy_autumn_arons_teryn_i_mitchell_michele_pignatelli_tomás_j_ryan_susumu_tonegawa_memory_retrieval_by_activating_engram_cells_in_mouse_models_of_early_alzheimers_disease.md": {
