    "/home/batesk52/CMU.49.007-Literature-Review/document_summaries/by_type/pdfs/unknown_npgrj_nn_1525_12631268.md": {
      "file_path": "/home/batesk52/CMU.49.007-Literature-Review/document_summaries/by_type/pdfs/unknown_npgrj_nn_1525_12631268.md",
