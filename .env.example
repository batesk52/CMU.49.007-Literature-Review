# Knowledge Base System Configuration
# Copy this file to .env and fill in your actual values

# ====================
# AI Provider API Keys
# ====================
# At least one AI provider API key is required for the system to work

# OpenAI Configuration (Recommended - best support)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini Configuration (Alternative provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude Configuration (Alternative provider)
CLAUDE_API_KEY=your_claude_api_key_here
# or
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ======================
# Optional Integrations
# ======================

# Zotero Integration (for academic literature processing)
ZOTERO_API_KEY=your_zotero_api_key_here
ZOTERO_USER_ID=your_zotero_user_id_here
ZOTERO_LIBRARY_TYPE=user  # or "group"

# Notion Integration (for audio transcription storage)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# ==================
# Path Configuration
# ==================

# Audio files folder (for audio_to_notion.py)
AUDIO_FOLDER_PATH=./audio_files

# ================
# Getting API Keys
# ================
# 
# OpenAI API Key:
#   1. Go to https://platform.openai.com/api-keys
#   2. Sign up or log in
#   3. Create a new API key
#   4. Copy and paste it above
#
# Gemini API Key:
#   1. Go to https://makersuite.google.com/app/apikey
#   2. Sign up or log in with Google
#   3. Create a new API key
#   4. Copy and paste it above
#
# Claude/Anthropic API Key:
#   1. Go to https://console.anthropic.com/
#   2. Sign up or log in
#   3. Create a new API key
#   4. Copy and paste it above
#
# Zotero API Key:
#   1. Go to https://www.zotero.org/settings/keys
#   2. Log in to your Zotero account
#   3. Create a new private key with read permissions
#   4. Copy the key and your user ID
#
# Notion Integration:
#   1. Go to https://www.notion.so/my-integrations
#   2. Create a new integration
#   3. Copy the integration token
#   4. Share your database with the integration
#   5. Copy the database ID from the database URL