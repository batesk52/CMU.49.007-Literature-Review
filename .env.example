# OpenAI API Configuration (Required for all tools)
OPENAI_API_KEY=your_openai_api_key_here

# Notion Integration (Required for audio_to_notion.py)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Zotero API Configuration (Required for zotero_to_anki.py)
ZOTERO_USER_ID=your_zotero_user_id_here
ZOTERO_LIBRARY_TYPE=user
ZOTERO_API_KEY=your_zotero_api_key_here

# Audio Processing Configuration (Optional)
AUDIO_FOLDER_PATH=./audio_files

# Instructions:
# 1. Copy this file to .env (cp .env.example .env)
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit your .env file to version control
#
# Getting API Keys:
# - OpenAI: https://platform.openai.com/api-keys
# - Notion: https://www.notion.so/my-integrations
# - Zotero: https://www.zotero.org/settings/keys
